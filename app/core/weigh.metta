; Two Agents, One Truth - symbolic core. All decisions are made here.
(= (rec $age) (if (< $age 8) 1.0 (if (< $age 31) 0.8 (if (< $age 91) 0.5 0.3))))
(= (rel $s) (match &self (reliability $s $r) $r))
; Each agent scores evidence through its own lens (pref = reliability weight, recency weight).
; A = Evidence Advocate (trusts reliable sources), B = Skeptical Auditor (distrusts stale data).
(pref A 0.7 0.3)
(pref B 0.3 0.7)
(= (sum-list $l) (foldl-atom $l 0 $a $x (+ $a $x)))
(= (ev-scores $ag $c) (collapse (match &self (, (evidence $c $s $o $age) (pref $ag $wr $wc)) (+ (* $wr (rel $s)) (* $wc (rec $age))))))
(= (lens $ag $c) (sum-list (ev-scores $ag $c)))
(= (support $c) (/ (+ (lens A $c) (lens B $c)) 2))
(= (abs $x) (if (< $x 0) (- 0 $x) $x))
(= (tau) 0.25)
(= (decide $t $ca $cb $sa $sb)
   (let $lr (collapse (match &self (learned-rule $t $ty $v $cond) (learned $ty $v $cond)))
     (if (== $lr ()) (decide-fresh $t $ca $cb $sa $sb) (car-atom $lr))))
(= (verdict $va $vb $t $ca $cb $sa $sb)
   (if (== $va $vb) (agree) (decide $t $ca $cb $sa $sb)))
(= (decide-fresh $t $ca $cb $sa $sb)
   (if (== $sa 0) (escalate-missing) (if (== $sb 0) (escalate-missing) (decide-scored $t $ca $cb $sa $sb))))
(= (decide-scored $t $ca $cb $sa $sb)
   (let $gap (abs (- $sa $sb))
     (let $tot (+ $sa $sb)
       (if (> (/ $gap $tot) (tau))
           (if (> $sa $sb) (concede B $ca) (concede A $cb))
           (let $cd (collapse (match &self (condition $t $v $cond) (conditional $v $cond)))
             (if (== $cd ()) (escalate) (car-atom $cd)))))))
(= (adjust $r $d) (let $n (+ $r $d) (if (> $n 0.98) 0.98 (if (< $n 0.05) 0.05 $n))))
